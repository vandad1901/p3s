# --- PG
PG_ADMIN_USER=pgadmin_root
PG_ADMIN_PASSWORD=

AUTH_PG_USER=p3s_auth
AUTH_PG_PASSWORD=
AUTH_PG_DATABASE=auth

# api, upload and media share this role and database
API_PG_USER=p3s_api
API_PG_PASSWORD=
API_PG_DATABASE=api

# --- RMQ
RMQ_USERNAME=p3s
RMQ_PASSWORD=

# --- Silo
S3_ROOT_USERNAME=
S3_ROOT_PASSWORD=
S3_EXTERNAL_ENDPOINT=https://s3.example.com
# Interface the gateway reaches silo on (host port 9000)
SILO_HOST_IP=10.0.0.2

# --- Auth
KEYSET_KEY_ID=auth-key-1
# Absolute path on the server, outside the repo. Must be readable by uid 65532. Can be generated with `just generate-secrets`
JWT_PRIVATE_KEY_FILE=/etc/p3s/jwt_private_key.pem
# Change this value only temporarily, logged in users are trusted completely.
CLOSED_REGISTRATION=true

# --- Edge
# Interface the gateway reaches envoy on (host port 8080)
ENVOY_HOST_IP=10.0.0.2
# Origin the frontend is served from (CORS for browser uploads to silo)
PUBLIC_ORIGIN=https://example.com

# --- Debug profile
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
