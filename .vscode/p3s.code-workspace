{
	"folders": [
		{
			"path": ".."
		},
		{
			"path": "../apps/auth"
		},
		{
			"path": "../apps/api"
		}
	],
	"extensions": {
		"recommendations": [
			"hverlin.mise-vscode",
			"golang.go"
		],
	},
	"settings": {
		"git.addAICoAuthor": "off",
		// Go settings
		"go.buildTags": "test",
		"go.testEnvFile": "${workspaceFolder}/.env.test",
		"go.testExplorer.enable": true,
		"go.testExplorer.showDynamicSubtestsInEditor": true,
		"go.testTags": "test",
		"go.lintTool": "golangci-lint-v2",
		"go.lintFlags": [
			"--path-mode=abs",
		],
		// Protobuf settings
		"protobuf.externalLinter.enabled": true,
		"protobuf.externalLinter.linter": "buf",
		"protobuf.externalLinter.bufPath": "buf",
		"protobuf.includes": [
			"${workspaceFolder}/protobuf"
		],
		// Mise settings
		"mise.configureExtensionsAutomatically": true,
		"mise.configureExtensionsUseShims": false,
		"mise.configureExtensionsUseSymLinks": true,
		
		"go.alternateTools": {
			"go": "${workspaceFolder}/.vscode/mise-tools/go",
			"dlv": "${workspaceFolder}/.vscode/mise-tools/dlv",
			"gopls": "${workspaceFolder}/.vscode/mise-tools/gopls"
		},
		"go.goroot": "${workspaceFolder}/.vscode/mise-tools/goRoot"
	}
}