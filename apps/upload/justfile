set shell := ["sh", "-cu"]
set dotenv-load

### Style

RED := '\033[0;31m'
GREEN := '\033[0;32m'
YELLOW := '\033[1;33m'
BLUE := '\033[0;34m'
NORMAL := '\033[0m'

@run:
    APP_ENV=development go run ./cmd/server/

@test:
    APP_ENV=test go test -tags test ./...

@db-reset:
    just db-down
    just db-up

@db-up:
    echo "{{ YELLOW }}[i] {{ BLUE }}upload{{ NORMAL }}{{ NORMAL }} Applying migrations to database"
    migrate -database "postgres://$API_PG_USER:$API_PG_PASSWORD@$API_PG_HOST:$API_PG_PORT/$API_PG_DATABASE?sslmode=disable&x-migrations-table=upload_schema_migrations" -path ./migrations up

    echo "{{ YELLOW }}[i] {{ BLUE }}upload{{ NORMAL }} {{ GREEN }}Creating{{ NORMAL }} S3 bucket"
    AWS_ACCESS_KEY_ID="$S3_ROOT_USERNAME" \
    AWS_SECRET_ACCESS_KEY="$S3_ROOT_PASSWORD" \
    AWS_PAGER="" \
    aws s3api create-bucket \
        --bucket "p3s-upload-bucket" \
        --endpoint-url "$S3_ENDPOINT"

@db-down:
    echo "{{ YELLOW }}[i] {{ BLUE }}upload{{ NORMAL }} {{ RED }}Clearing{{ NORMAL }} S3 bucket"
    AWS_ACCESS_KEY_ID="$S3_ROOT_USERNAME" \
    AWS_SECRET_ACCESS_KEY="$S3_ROOT_PASSWORD" \
    AWS_PAGER="" \
    aws s3 rm "s3://p3s-upload-bucket" \
    --recursive \
    --endpoint-url "$S3_ENDPOINT"

    echo "{{ YELLOW }}[i] {{ BLUE }}upload{{ NORMAL }} {{ RED }}Removing{{ NORMAL }} S3 bucket"
    AWS_ACCESS_KEY_ID="$S3_ROOT_USERNAME" \
    AWS_SECRET_ACCESS_KEY="$S3_ROOT_PASSWORD" \
    AWS_PAGER="" \
    aws s3api delete-bucket \
        --bucket "p3s-upload-bucket" \
        --endpoint-url "$S3_ENDPOINT" 
