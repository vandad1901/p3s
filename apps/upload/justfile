set shell := ["sh", "-cu"]
set dotenv-load

### Style

RED := '\033[0;31m'
GREEN := '\033[0;32m'
YELLOW := '\033[1;33m'
BLUE := '\033[0;34m'
NORMAL := '\033[0m'

@run:
    go run ./cmd/server/

@test:
    go test -tags test ./...

@db-reset:
    just db-down
    just db-up

@db-up:
    echo "{{ YELLOW }}[i] {{ BLUE }}upload{{ NORMAL }}{{ NORMAL }} Applying migrations to database"
    migrate -database "postgres://$UPLOAD_PG_USER:$UPLOAD_PG_PASSWORD@$UPLOAD_PG_HOST:$UPLOAD_PG_PORT/$UPLOAD_PG_DATABASE?sslmode=disable&x-migrations-table=upload_schema_migrations" -path ./migrations up

